#!/bin/sh
# Serves the trainer locally: over file:// browsers may keep storage per page, so games lose the player name.
# Usage: bin/start [port]. Stop with Ctrl+C.
cd "$(dirname "$0")/.." || exit 1
port="${1:-8000}"
echo "http://127.0.0.1:$port/"
exec python3 -m http.server "$port" --bind 127.0.0.1
